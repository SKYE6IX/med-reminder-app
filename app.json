{
  "expo": {
    "name": "MedRemindR",
    "slug": "medreminder-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "scheme": "medreminderapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medreminderapp.MedRemindR",
      "usesAppleSignIn": true,
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-light.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#F7F7F7"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.medreminderapp.MedRemindR",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F7",
          "dark": {
            "image": "./assets/icons/splash-icon-dark.png",
            "backgroundColor": "#1C1C1E"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/universfield_soft.wav",
            "./assets/sounds/universfield_passive.wav",
            "./assets/sounds/dragon_wavy.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение получит доступ к вашей фотографии, чтобы вы могли выбрать аватар."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication",
      "./app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
